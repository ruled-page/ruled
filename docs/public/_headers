# Cloudflare Pages response headers.

/*
  # Kept out of search results until the package is published; remove this line to have it indexed.
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro puts a content hash in every file name under /_astro, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
