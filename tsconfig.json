{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    // Workspace packages are read from their source, as Vite reads them.
    "customConditions": ["source"]
  },
  "include": ["packages", "examples", "vite.config.ts"],
  // Built against the packed library by scripts/host-app.mjs, which needs it built first.
  "exclude": ["packages/e2e/host-app", "examples/angular-portal", "**/dist", "**/node_modules"]
}
