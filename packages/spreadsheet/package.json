{
  "name": "@ruled/sheet",
  "version": "0.1.0",
  "description": "Ruled: edit Excel workbooks in the browser and save them back without losing charts, pivot tables or formulas: a React component, and a <workbook-editor> web component",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "Anthony Gubler",
  "scripts": {
    "build": "vite build -c vite.lib.config.ts --mode react && vite build -c vite.lib.config.ts --mode standalone && vite build -c vite.node.config.ts && tsc -p tsconfig.lib.json && rolldown -c rolldown.types.config.ts",
    "build:verify": "vite build -c vite.verify.config.ts",
    "validate:saves": "node scripts/validate-saves.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "exports": {
    ".": {
      "source": "./src/editor/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react/workbook-editor.js"
    },
    "./standalone": {
      "source": "./src/editor/standalone.ts",
      "types": "./dist/types/standalone.d.ts",
      "import": "./dist/standalone/workbook-editor.js"
    },
    "./node": {
      "source": "./src/node/index.ts",
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node/index.js"
    },
    "./style.css": "./dist/react/workbook-editor.css",
    "./worker": "./dist/react/assets/workbook.worker.js",
    "./internal/*": {
      "source": "./src/*"
    },
    "./testing/*": {
      "source": "./tests/*"
    }
  },
  "files": [
    "dist/react",
    "dist/standalone",
    "dist/node",
    "dist/types",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@borgar/fx": "^5.1.3",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@ruled/formula": "0.1.0",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "numfmt": "^3.2.6",
    "react-i18next": "^17.0.16",
    "rolldown": "1.2.12",
    "rolldown-plugin-dts": "0.28.6"
  }
}
