{
  // Type declarations for the library builds, which rolldown.types.config.ts bundles into dist/types.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/declarations",
    "rootDir": "src"
  },
  "include": ["src/editor/index.ts", "src/editor/standalone.ts"]
}
