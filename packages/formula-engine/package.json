{
  "name": "@ruled/formula",
  "version": "0.1.0",
  "description": "Excel's formulas worked out in the browser or Node, cell by cell as a workbook changes, with Excel's rules throughout",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "source": "./src/engine.ts"
    },
    "./native": {
      "source": "./src/native.ts"
    },
    "./formula": {
      "source": "./src/formula.ts"
    },
    "./refs": {
      "source": "./src/refs.ts"
    },
    "./wildcard": {
      "source": "./src/wildcard.ts"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "README.md"
  ],
  "dependencies": {
    "@borgar/fx": "^5.1.3",
    "numfmt": "^3.2.6"
  },
  "devDependencies": {
    "rolldown": "1.2.12",
    "rolldown-plugin-dts": "0.28.6"
  }
}
