{
  "name": "fake-spreadsheet",
  "version": "1.0.0",
  "description": "Proof of concept: edit .xlsx workbooks in the browser and save them back without losing charts, pivots or formulas",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/gen-samples.mjs",
    "pages:dev": "npm run build && wrangler pages dev --port 8788",
    "deploy": "npm run build && wrangler pages deploy --branch main --commit-dirty=true",
    "build:lib": "vite build -c vite.lib.config.ts --mode react && vite build -c vite.lib.config.ts --mode standalone && tsc -p tsconfig.lib.json",
    "build:node": "vite build -c vite.node.config.ts",
    "e2e": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@borgar/fx": "^5.1.3",
    "@glideapps/glide-data-grid": "^6.0.3",
    "fflate": "^0.8.3",
    "hyperformula": "^3.4.0",
    "i18next": "^26.4.2",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "numfmt": "^3.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16",
    "react-responsive-carousel": "^3.2.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist-lib/types/editor/index.d.ts",
      "import": "./dist-lib/react/workbook-editor.js"
    },
    "./standalone": {
      "types": "./dist-lib/types/editor/standalone.d.ts",
      "import": "./dist-lib/standalone/workbook-editor.js"
    },
    "./style.css": "./dist-lib/react/workbook-editor.css",
    "./node": {
      "import": "./dist-node/index.js"
    }
  },
  "files": [
    "dist-lib",
    "dist-node"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "bin": {
    "workbook-check": "./dist-node/cli.js",
    "workbook-verify": "./dist-node/verify.js"
  }
}
