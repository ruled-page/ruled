{
  "name": "workbook-editor",
  "version": "0.1.0",
  "description": "Edit Excel workbooks in the browser and save them back without losing charts, pivot tables or formulas",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --mode perf tests/perf.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests e2e scripts vite.config.ts vite.lib.config.ts vite.verify.config.ts vite.glide.ts playwright.config.ts",
    "samples": "node scripts/gen-samples.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "pages:dev": "node scripts/build-sites.mjs demo && wrangler pages dev --port 8788",
    "deploy": "npm run deploy:demo && npm run deploy:portal && npm run deploy:angular",
    "deploy:demo": "node scripts/build-sites.mjs demo && wrangler pages deploy --branch main --commit-dirty=true",
    "deploy:portal": "node scripts/build-sites.mjs portal && wrangler pages deploy --cwd sites/portal --branch main --commit-dirty=true",
    "deploy:angular": "node scripts/build-sites.mjs angular && wrangler pages deploy --cwd sites/angular --branch main --commit-dirty=true",
    "build:lib": "vite build -c vite.lib.config.ts --mode react && vite build -c vite.lib.config.ts --mode standalone && tsc -p tsconfig.lib.json",
    "build:verify": "vite build -c vite.verify.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "engine:bench": "ENGINE_BENCH=1 NODE_OPTIONS=--expose-gc vitest run engines --silent=false",
    "excel:check": "ENGINE_BENCH=1 vitest run excel-check --silent=false",
    "validate:saves": "node scripts/validate-saves.mjs",
    "e2e": "playwright test",
    "notices": "node scripts/notices.mjs",
    "release": "node scripts/release.mjs"
  },
  "author": "Anthony Gubler",
  "license": "UNLICENSED",
  "dependencies": {
    "@borgar/fx": "^5.1.3",
    "@glideapps/glide-data-grid": "^6.0.3",
    "chart.js": "^4.5.1",
    "fflate": "^0.8.3",
    "hyperformula": "^3.4.0",
    "i18next": "^26.4.2",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "numfmt": "^3.2.6",
    "react-i18next": "^17.0.16",
    "react-responsive-carousel": "^3.2.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "exceljs": "^4.4.0",
    "oxlint": "~1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist-lib/types/editor/index.d.ts",
      "import": "./dist-lib/react/workbook-editor.js"
    },
    "./standalone": {
      "types": "./dist-lib/types/editor/standalone.d.ts",
      "import": "./dist-lib/standalone/workbook-editor.js"
    },
    "./style.css": "./dist-lib/react/workbook-editor.css",
    "./worker": "./dist-lib/react/assets/workbook.worker.js"
  },
  "files": [
    "dist-lib",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "@glideapps/glide-data-grid": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
